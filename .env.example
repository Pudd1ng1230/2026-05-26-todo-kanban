# Todo Kanban 环境变量配置
# 复制此文件为 .env（不会被 Git 追踪）并填入实际值

# ── 服务端 ──
# 监听端口（默认 3001）
PORT=3001

# API 认证密钥（生产环境必须设置！留空则跳过认证）
# 生成建议：openssl rand -hex 32
API_KEY=your-secret-api-key-here

# 运行模式：production 时 Express 会托管前端构建产物
NODE_ENV=production

# ── 客户端（构建时注入，需 VITE_ 前缀） ──
# 必须与后端 API_KEY 一致
VITE_API_KEY=your-secret-api-key-here
